// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                @id @default(autoincrement())
  username           String             @unique
  email              String             @unique
  passwordHash       String
  roles              String[]
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  firstName          String
  lastName           String
  phone              String
  address            String
  city               String
  country            String
  latitude           Float?
  longitude          Float?
  AFM                String             @unique
  registrationStatus RegistrationStatus @default(PENDING)
  organizedEvents    Event[]            @relation("EventOrganizer")
  bookings           Booking[]
  sentMessages       Message[]          @relation("MessageSender")
  receivedMessages   Message[]          @relation("MessageReceiver")
  eventViews         EventView[]
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Event {
  id            Int         @id @default(autoincrement())
  title         String
  eventType     String
  venue         String
  address       String
  city          String
  country       String
  latitude      Float?
  longitude     Float?
  startDateTime DateTime
  endDateTime   DateTime
  capacity      Int
  reservedSeats Int         @default(0)
  status        EventStatus @default(DRAFT)
  description   String
  organizerId   Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organizer       User            @relation("EventOrganizer", fields: [organizerId], references: [id])
  ticketTypes     TicketType[]
  eventCategories EventCategory[]
  bookings        Booking[]

  photos   Photo[]
  views    EventView[]
  messages Message[]

  @@index([status])
  @@index([startDateTime])
  @@index([city])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

model TicketType {
  id        Int     @id @default(autoincrement())
  eventId   Int
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  available Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([eventId])
}

model Category {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  events EventCategory[]
}

model EventCategory {
  eventId    Int
  categoryId Int

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
}

model Booking {
  id              Int           @id @default(autoincrement())
  eventId         Int
  ticketTypeId    Int
  attendeeId      Int
  time            DateTime      @default(now())
  numberOfTickets Int
  totalCost       Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(CONFIRMED)

  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  attendee   User       @relation(fields: [attendeeId], references: [id])
  messages   Message[]

  @@index([eventId])
  @@index([attendeeId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Photo {
  id       Int    @id @default(autoincrement())
  eventId  Int
  filePath String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Message {
  id                Int      @id @default(autoincrement())
  senderId          Int
  receiverId        Int
  eventId           Int?
  bookingId         Int?
  subject           String
  content           String
  isRead            Boolean  @default(false)
  deletedBySender   Boolean  @default(false)
  deletedByReceiver Boolean  @default(false)
  createdAt         DateTime @default(now())

  sender   User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([receiverId, isRead])
  @@index([senderId])
}

model EventView {
  id       Int      @id @default(autoincrement())
  userId   Int
  eventId  Int
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([eventId])
}