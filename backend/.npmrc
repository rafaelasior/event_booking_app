# --- Πηγές: μόνο registry ---
allow-git=none
allow-remote=none
allow-file=root
allow-directory=root

# --- Scripts: hard error αντί για warning ---
strict-allow-scripts=true

# --- Αυστηρότητα ---
strict-npmrc=true
strict-ssl=true
engine-strict=true
strict-peer-deps=true

# --- Cooldown: τίποτα που δημοσιεύτηκε τις τελευταίες 7 μέρες ---
min-release-age=7
min-release-age-exclude[]=@myorg/*

# --- Ντετερμινισμός ---
save-exact=true
package-lock=true
lockfile-version=3

registry=https://registry.npmjs.org/
audit=true
audit-level=moderate
fund=false